 #[tokio::test]
+async fn entering_plan_keeps_selected_model_over_catalog_preset() {
+    let (mut chat, _rx, _ops) = make_chatwidget_manual(Some("selected")).await;
+    chat.set_feature_enabled(Feature::CollaborationModes, true);
+    let plan = Arc::make_mut(&mut chat.model_catalog)
+        .collaboration_modes
+        .iter_mut()
+        .find(|mask| mask.mode == Some(ModeKind::Plan))
+        .expect("Plan preset");
+    plan.model = Some("other-model".into());
+    chat.set_plan_mode_reasoning_effort(Some(ReasoningEffortConfig::High));
+    chat.dispatch_command(SlashCommand::Plan);
+    assert_eq!(chat.active_collaboration_mode_kind(), ModeKind::Plan);
+    assert_eq!(chat.current_model(), "selected");
+    assert_eq!(
+        chat.current_reasoning_effort(),
+        Some(ReasoningEffortConfig::High)
+    );
+}
