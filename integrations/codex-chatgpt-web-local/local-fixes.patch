+  const message = object(node?.message);
+  if (!node || node.id !== body.current_node || message?.id !== body.current_node
+    || message?.author?.role !== "assistant" || message.channel !== "final"
+    || message.status !== "finished_successfully" || message.end_turn !== true
+    || (message.recipient !== undefined && message.recipient !== "all")
+    || message.content?.content_type !== "text" || !Array.isArray(message.content.parts)
+    || !message.content.parts.every((part: unknown) => typeof part === "string")) return undefined;
