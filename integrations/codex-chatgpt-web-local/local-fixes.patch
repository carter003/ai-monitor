+import { ChatGptConversationFinalReadback, chatGptConversationFinalSource, chatGptFinalJsonIsRequired } from "../src/adapters/chatgpt-web/browser-worker";
+
+const conversationId = "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa";
+const userId = "bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb";
+const finalId = "cccccccc-cccc-cccc-cccc-cccccccccccc";
+const groupId = "dddddddd-dddd-dddd-dddd-dddddddddddd";
+const text = JSON.stringify({ findings: [], overall_correctness: "patch is correct", literal: '_name_ `code` C:\\tmp\\a "quoted"\n```json' });
+const schema = { type: "json_schema" as const, name: "review", strict: true, schema: { type: "object" } };
+const readback = () => ({ conversation_id: conversationId, current_node: finalId, mapping: {
+  [userId]: { id: userId, parent: null, message: { id: userId, author: { role: "user" } } },
+  tool: { id: "tool", parent: userId, message: { id: "tool", author: { role: "tool" }, status: "in_progress", content: { parts: ["private tool data"] } } },
+  [finalId]: { id: finalId, parent: "tool", message: { id: finalId, author: { role: "assistant" }, channel: "final", status: "finished_successfully", end_turn: true, content: { content_type: "text", parts: [text] } } },
+} });
+
+test("async tool final is projected to exact raw JSON and ownership only", () => {
+  const source = chatGptConversationFinalSource(readback(), conversationId)!;
+  expect(source).toEqual({ conversationId, userMessageId: userId, messageId: finalId, text });
+  expect(JSON.stringify(source)).not.toContain("private tool data");
