+++ b/tests/raw-final-json.test.ts
@@ -0,0 +1,262 @@
+import { expect, test } from "bun:test";
+import { RawFinalJsonCollector } from "../src/adapters/chatgpt-web/raw-final-json";
+
+const frame = (value: unknown) => `data: ${JSON.stringify(value)}\n\n`;
+const done = "data: [DONE]\n\n";
+const message = (text: string, overrides: Record<string, unknown> = {}) => ({
+  id: "synthetic-message", author: { role: "assistant" }, channel: "final",
+  status: "finished_successfully", end_turn: true,
+  content: { content_type: "text", parts: [text] }, ...overrides,
+});
+const terminal = frame({ p: "", o: "patch", v: [
+  { p: "/message/status", o: "replace", v: "finished_successfully" },
+  { p: "/message/end_turn", o: "replace", v: true },
+] });
+const push = (collector: RawFinalJsonCollector, value: string) => collector.push(Buffer.from(value));
+
+test("whole final messages preserve JSON escapes, underscores, arrays, and Unicode exactly", () => {
+  const text = String.raw`{"overall_correctness":"合法_值","items":["C:\\tmp\\a_b","\\[literal\\]","a\nb"]}`;
+  const collector = new RawFinalJsonCollector();
+  const bytes = Buffer.from(frame({ message: message(text) }) + done);
+  for (const byte of bytes) collector.push(Uint8Array.of(byte));
+  expect(collector.getCompletedJson()).toBe(text);
+  expect(JSON.parse(collector.getCompletedJson()!)).toEqual(JSON.parse(text));
+});
+
+test("JSON candidates are provisional until successful status, end_turn and DONE", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ message: message('{"ok":', { status: "in_progress", end_turn: false }) }));
+  expect(collector.latestJsonCandidate()).toBe('{"ok":');
+  expect(collector.getCompletedJson()).toBeUndefined();
+  push(collector, frame({ p: "/message/content/parts/0", o: "append", v: "true}" }));
+  expect(collector.getCompletedJson()).toBeUndefined();
+  push(collector, terminal);
+  expect(collector.getCompletedJson()).toBeUndefined();
+  push(collector, done);
+  expect(collector.getCompletedJson()).toBe('{"ok":true}');
+});
+
+test("batched patches and inherited value-only appends reconstruct exact text", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ p: "", o: "add", v: { message: message("", { status: "in_progress", end_turn: false }) } })
+    + frame({ p: "/message/content/parts/0", o: "append", v: '{"overall_' })
+    + frame({ v: 'correctness":' })
+    + frame({ p: "", o: "patch", v: [
+      { p: "/message/content/parts/0", o: "append", v: '"ok"' }, { v: "}" },
+      { p: "/message/status", o: "replace", v: "finished_successfully" },
+      { p: "/message/end_turn", o: "replace", v: false }, { v: true },
+    ] }) + done);
+  expect(collector.getCompletedJson()).toBe('{"overall_correctness":"ok"}');
+});
+
+test("nested patch fields cannot steal the context of a following root message", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ p: "", o: "add", v: { message: message('{"old":true}') } })
+    + frame({ o: "patch", v: [{ p: "/message/status", o: "replace", v: "finished_partial" }] })
+    + frame({ o: "add", v: { message: message('{"current":true}') } }) + done);
+  expect(collector.getCompletedJson()).toBe('{"current":true}');
+});
+
+test("content and parts replacements revise the undelivered draft instead of appending twice", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ message: message('{"old":0}') })
+    + frame({ p: "/message/content", o: "replace", v: { content_type: "text", parts: ["[", "1]"] } })
+    + frame({ p: "/message/content/parts/1", o: "replace", v: "2" })
+    + frame({ p: "/message/content/parts/2", o: "add", v: "]" }) + done);
+  expect(collector.getCompletedJson()).toBe("[2]");
+});
+
+test("analysis, commentary, tool, and metadata payloads never become final text or serialized state", () => {
+  const collector = new RawFinalJsonCollector();
+  for (const [role, channel] of [["assistant", "analysis"], ["tool", "final"], ["assistant", "commentary"]]) {
+    push(collector, frame({ message: message('"PRIVATE-body"', { author: { role }, channel }) })
+      + frame({ p: "/message/content/parts/0", o: "append", v: "PRIVATE-delta" }));
+    expect(collector.latestJsonCandidate()).toBeUndefined();
+  }
+  push(collector, frame({ message: message('{"public":true}', { metadata: { secret: "PRIVATE-meta" } }) })
+    + frame({ p: "/message/metadata", o: "replace", v: { secret: "PRIVATE-patch" } }) + done);
+  expect(collector.getCompletedJson()).toBe('{"public":true}');
+  expect(JSON.stringify(collector)).toBe("{}");
+  expect(JSON.stringify({ ...collector })).toBe("{}");
+});
+
+test("a late final channel never promotes discarded commentary or guesses its missing prefix", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ message: message('{"PRIVATE":', { channel: "commentary" }) })
+    + frame({ p: "/message/channel", o: "replace", v: "final" })
+    + frame({ p: "/message/content/parts/0", o: "append", v: "true}" }) + done);
+  expect(collector.latestJsonCandidate()).toBeUndefined();
+  expect(collector.getCompletedJson()).toBeUndefined();
+});
+
+test("a complete replacement can establish the base after a late channel change", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ message: message("PRIVATE", { channel: "analysis" }) })
+    + frame({ p: "/message/channel", o: "replace", v: "final" })
+    + frame({ p: "/message/content", o: "replace", v: { content_type: "text", parts: ['{"safe":true}'] } }) + done);
+  expect(collector.getCompletedJson()).toBe('{"safe":true}');
+});
+
+test("a subsequent non-final message invalidates the previous final candidate", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ message: message('{"stale":true}') })
+    + frame({ message: message("PRIVATE", { channel: "analysis" }) }) + done);
+  expect(collector.getCompletedJson()).toBeUndefined();
+});
+
+test("incomplete, malformed, service-error, and unknown-base streams cannot qualify", () => {
+  for (const input of [
+    frame({ message: message('{"ok":true}') }),
+    frame({ message: message('{"ok":true}', { status: "in_progress" }) }) + done,
+    frame({ message: message('{"ok":true}', { end_turn: false }) }) + done,
+    frame({ message: message('{"ok":true}', { status: "finished_partial" }) }) + done,
+    frame({ message: message('{"ok":true}') }) + done + "data: {",
+    "data: {broken}\n\n" + frame({ message: message("{}") }) + done,
+    frame({ error: "PRIVATE-service-error" }) + frame({ message: message("{}") }) + done,
+    frame({ v: "missing base" }) + frame({ message: message("{}") }) + done,
+    frame({ message: message("{}") }) + frame({ p: "/message/content/unknown", o: "replace", v: "x" }) + done,
+  ]) {
+    const collector = new RawFinalJsonCollector();
+    push(collector, input);
+    expect(collector.getCompletedJson()).toBeUndefined();
+  }
+});
+
+test("only one entire valid JSON value qualifies, including scalar schema values", () => {
+  for (const text of ["{}", "[]", '"hello_world"', "true", "false", "null", "123", "-1.25e2", " \n{}\r\n"]) {
+    const collector = new RawFinalJsonCollector();
+    push(collector, frame({ message: message(text) }) + done);
+    expect(collector.getCompletedJson()).toBe(text);
+  }
+  for (const text of ['{"bad":', "{} {}", "```json\n{}\n```", "text {}", String.raw`{"bad\_key":1}`]) {
+    const collector = new RawFinalJsonCollector();
+    push(collector, frame({ message: message(text) }) + done);
+    expect(collector.getCompletedJson()).toBeUndefined();
+  }
+});
+
+test("frame, total text, frame count and patch bounds fail closed", () => {
+  const cases = [
+    { limits: { maxFrameChars: 64 }, input: frame({ message: message("{}") }) },
+    { limits: { maxTextChars: 3 }, input: frame({ message: message("[123]") }) },
+    { limits: { maxTextChars: 3 }, input: frame({ message: message("[") })
+      + frame({ p: "/message/content/parts/0", o: "append", v: "123]" }) },
+    { limits: { maxFrames: 1 }, input: frame({ message: message("{}") }) + frame({ type: "ping" }) },
+    { limits: {}, input: frame({ message: message("{}") })
+      + frame({ p: "", o: "patch", v: Array.from({ length: 257 }, () => ({ p: "/message/status", o: "replace", v: "finished_successfully" })) }) },
+  ];
+  for (const { limits, input } of cases) {
+    const collector = new RawFinalJsonCollector(limits);
+    push(collector, input + done);
+    expect(collector.getCompletedJson()).toBeUndefined();
+    expect(collector.latestJsonCandidate()).toBeUndefined();
+  }
+});
+
+test("CRLF and SSE multi-line data fields are decoded without changing final text", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, `event: message\r\ndata: {"message":\r\ndata: ${JSON.stringify(message("[1,2]"))}}\r\n\r\n`
+    + "data: [DONE]\r\n\r\n");
+  expect(collector.getCompletedJson()).toBe("[1,2]");
+});
+
+test("invalid UTF-8 and payloads after DONE cannot silently alter a completed result", () => {
+  const collector = new RawFinalJsonCollector();
+  collector.push(Uint8Array.of(0xff));
+  push(collector, frame({ message: message("{}") }) + done);
+  expect(collector.getCompletedJson()).toBeUndefined();
+  const trailing = new RawFinalJsonCollector();
+  push(trailing, frame({ message: message("{}") }) + done + frame({ message: message("[]") }));
+  expect(trailing.getCompletedJson()).toBeUndefined();
+});
+
+test("the v1 delta_encoding protocol marker precedes whole messages and value-only text patches", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, 'event: delta_encoding\ndata: "v1"\n\n'
+    + frame({ p: "", o: "add", v: { message: message("", { status: "in_progress", end_turn: false }) } })
+    + frame({ p: "/message/content/parts/0", o: "append", v: '{"overall_correctness":' })
+    + frame({ v: '"correct"}' }) + terminal + done);
+  expect(collector.getCompletedJson()).toBe('{"overall_correctness":"correct"}');
+  for (const marker of ['data: "v1"\n\n', 'event: delta_encoding\ndata: "v2"\n\n']) {
+    const unknown = new RawFinalJsonCollector();
+    push(unknown, marker + frame({ message: message("{}") }) + done);
+    expect(unknown.getCompletedJson()).toBeUndefined();
+  }
+});
+
+test("ordinary Markdown bullets and scalar-looking prose do not request a JSON hold", () => {
+  for (const text of ["- bullet", "true story", "normal prose", "# Heading", "123. numbered list", "```json\n{}\n```", "```\n[1,2]\n```" ]) {
+    const collector = new RawFinalJsonCollector();
+    push(collector, frame({ message: message(text) }) + done);
+    expect(collector.latestJsonCandidate()).toBeUndefined();
+    expect(collector.latestFinalText()).toBe(text);
+    expect(collector.getCompletedJson()).toBeUndefined();
+  }
+});
+
+test("an initially JSON-looking draft may be replaced with prose for Markdown fallback", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ message: message('{"draft":', { status: "in_progress", end_turn: false }) }));
+  expect(collector.latestJsonCandidate()).toBe('{"draft":');
+  push(collector, frame({ p: "/message/content/parts/0", o: "replace", v: "- ordinary bullet" }) + terminal + done);
+  expect(collector.latestJsonCandidate()).toBeUndefined();
+  expect(collector.latestFinalText()).toBe("- ordinary bullet");
+  expect(collector.getCompletedJson()).toBeUndefined();
+});
+
+test("oversized Unicode user frames fail within bounds without exposing private payloads", () => {
+  const collector = new RawFinalJsonCollector({ maxFrameChars: 512 });
+  const bytes = Buffer.from(frame({ message: message("PRIVATE-秘密".repeat(200), {
+    author: { role: "user" }, channel: null,
+  }) }) + frame({ message: message("{}") }) + done);
+  for (let offset = 0; offset < bytes.length; offset += 17) collector.push(bytes.subarray(offset, offset + 17));
+  expect(collector.getCompletedJson()).toBeUndefined();
+  expect(JSON.stringify(collector)).toBe("{}");
+});
+
+
+test("pending UTF-8 bytes after DONE keep the source incomplete across chunk boundaries", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ message: message("{}") }) + done);
+  collector.push(Uint8Array.of(0xe7));
+  expect(collector.getCompletedJson()).toBeUndefined();
+  collector.push(Uint8Array.of(0xa7));
+  expect(collector.getCompletedJson()).toBeUndefined();
+});
+
+test("message identity patches cannot relabel a previously captured final", () => {
+  const collector = new RawFinalJsonCollector();
+  push(collector, frame({ message: message('{"stale":true}') })
+    + frame({ p: "/message/id", o: "replace", v: "another-message" }) + done);
+  expect(collector.getCompletedJson()).toBeUndefined();
+});
+
+
+test("failure diagnostics distinguish missing DONE, unfinished messages, malformed JSON and protocol errors", () => {
+  const cases = [
+    [frame({ message: message('{}') }), "missing_done"],
+    [frame({ message: message('{}', { end_turn: false }) }) + done, "unfinished_message"],
+    [frame({ message: message('{"PRIVATE-payload":') }) + done, "invalid_json"],
+    ["data: {PRIVATE-broken}\n\n", "malformed_frame"],
+    [frame({ error: "PRIVATE-error" }), "service_or_protocol_error"],
+    [frame({ message: message('{}') }) + done, "complete"],
+  ];
+  for (const [input, reason] of cases) {
+    const collector = new RawFinalJsonCollector();
+    push(collector, input!);
+    expect(collector.snapshot().reason).toBe(reason);
+    const serialized = JSON.stringify(collector.snapshot());
+    expect(serialized).not.toContain("PRIVATE");
+    expect(serialized).not.toContain("synthetic-message");
+    expect(JSON.stringify(collector)).toBe("{}");
+  }
+});
+
+
+test("payload-free remove patches cannot leave deleted final content eligible", () => {
+  for (const path of ["", "/message", "/message/content", "/message/content/parts/0", "/message/status"]) {
+    const collector = new RawFinalJsonCollector();
+    push(collector, frame({ message: message('{}') }) + frame({ p: path, o: "remove" }) + done);
+    expect(collector.getCompletedJson()).toBeUndefined();
+  }
+});
