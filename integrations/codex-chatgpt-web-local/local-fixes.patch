+test("begin, a new request and dispose immediately fence and wake a pending tail drain", async () => {
+  for (const action of ["begin", "request", "dispose"] as const) {
+    const buffered = Promise.withResolvers<{ bufferedData: string }>();
+    const owned = rawSession(buffered.promise);
+    const reports: any[] = [];
+    const observer = new ChatGptStreamDiagnostics(value => reports.push(value), { collectFinalJson: true });
+    await observer.attach(owned.page);
+    observer.begin();
+    owned.request("old");
+    owned.response("old");
+    const oldFinishes = [observer.finishFinalJson(), observer.finishFinalJson()];
+    if (action === "begin") observer.begin();
+    else if (action === "request") owned.request("new");
+    else await observer.dispose();
+    // Resolving the CDP command is deliberately deferred until both waits wake.
+    const results = await Promise.race([
+      Promise.all(oldFinishes),
+      new Promise<never>((_, reject) => {
+        const timer = setTimeout(() => reject(new Error("Tail drain did not wake")), 250);
+        void Promise.all(oldFinishes).finally(() => clearTimeout(timer));
+      }),
+    ]);
+    expect(results).toEqual([undefined, undefined]);
+    buffered.resolve({ bufferedData: Buffer.from(rawFinal('{"PRIVATE-stale":true}') + done).toString("base64") });
+    await flush();
+    expect(observer.latestJsonCandidate()).toBeUndefined();
+    expect(reports.filter(report => report.phase)).toHaveLength(0);
+    await observer.dispose();
+    expect(JSON.stringify(reports)).not.toContain("PRIVATE");
+  }
+});
