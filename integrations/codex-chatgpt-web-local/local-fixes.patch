+    (b: any) => { b.conversation_id = "other"; },
+    (b: any) => { b.current_node = "tool"; },
+    (b: any) => { b.mapping[finalId].id = "other"; },
+    (b: any) => { b.mapping[finalId].message.id = "other"; },
+    (b: any) => { b.mapping[finalId].message.author.role = "tool"; },
+    (b: any) => { b.mapping[finalId].message.channel = "commentary"; },
+    (b: any) => { b.mapping[finalId].message.status = "in_progress"; },
+    (b: any) => { b.mapping[finalId].message.end_turn = false; },
+    (b: any) => { b.mapping[finalId].message.recipient = "tool"; },
+    (b: any) => { b.mapping[finalId].message.content.parts = ["{broken"]; },
+    (b: any) => { b.mapping[finalId].message.content.parts = [text, {}]; },
+    (b: any) => { b.mapping[finalId].message.content.parts = ['"' + 'x'.repeat(1_000_000) + '"']; },
+    (b: any) => { b.mapping.tool.parent = "tool"; },
+    (b: any) => { b.mapping[userId].message.id = "other"; },
+  ];
+  for (const mutate of mutations) {
