+  const observer = new ChatGptConversationFinalReadback();
+  observer.attach(page as never);
+  observer.begin();
+  const read = () => observer.read(locator as never, `group:assistant:${groupId}`, `group:user:${groupId}`);
+  return { observer, page, root, response, read };
