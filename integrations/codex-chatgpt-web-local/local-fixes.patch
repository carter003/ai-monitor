+function fixture() {
+  const { createWindow } = require("@mixmark-io/domino");
+  const window = createWindow(`<div data-turn-key="${groupId}"><div data-content-search-unit-key="${finalId}:0:user" data-chatgpt-search-unit-key="${groupId}:0:user" data-chatgpt-search-message-ids="${userId}"><div data-user-message-bubble></div></div><div data-chatgpt-search-message-ids="tool ${finalId}"><div data-conversation-role="assistant"></div></div></div>`);
+  const root = window.document.body.firstElementChild;
+  const context = createContext({ document: window.document, getComputedStyle: (node: HTMLElement) => node.style });
+  const page = new EventEmitter() as EventEmitter & { url: () => string; mainFrame: () => object };
+  const frame = {};
+  page.url = () => `https://chatgpt.com/c/${conversationId}`;
+  page.mainFrame = () => frame;
+  const response = (body: unknown = readback()) => ({
