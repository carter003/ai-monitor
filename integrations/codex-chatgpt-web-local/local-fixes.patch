 });
+
+const rawFinal = (text: string) => frame({ message: {
+  id: "synthetic-final", author: { role: "assistant" }, channel: "final",
+  status: "finished_successfully", end_turn: true,
+  content: { content_type: "text", parts: [text] }, metadata: { secret: "PRIVATE-metadata" },
+} });
+const done = "data: [DONE]\n\n";
+const flush = () => new Promise<void>(resolve => setImmediate(resolve));
+
+function rawSession(buffered: Promise<{ bufferedData: string }> = Promise.resolve({ bufferedData: "" })) {
+  const session = new EventEmitter() as any;
+  session.send = async (method: string) => method === "Page.getFrameTree"
+    ? { frameTree: { frame: { id: "main" } } }
+    : method === "Network.streamResourceContent" ? buffered : {};
+  session.detach = async () => {};
+  const page = { context: () => ({ newCDPSession: async () => session }) } as any;
+  const request = (id: string, owner = "main") => session.emit("Network.requestWillBeSent", {
+    requestId: id, frameId: owner,
+    request: { method: "POST", url: "https://chatgpt.com/backend-api/f/conversation" },
+  });
+  const response = (id: string, status = 200, mimeType = "text/event-stream") => session.emit("Network.responseReceived", {
+    requestId: id, response: { status, mimeType },
+  });
+  const data = (id: string, text: string) => session.emit("Network.dataReceived", {
+    requestId: id, data: Buffer.from(text).toString("base64"),
+  });
+  return { session, page, request, response, data };
+}
+
+test("raw final collection is opt-in and reports stay content-free when enabled", async () => {
+  for (const enabled of [false, true]) {
+    const reports: any[] = [];
+    const owned = rawSession();
+    const observer = new ChatGptStreamDiagnostics(value => reports.push(value), { collectFinalJson: enabled });
+    await observer.attach(owned.page);
+    observer.begin();
+    owned.request("owned");
+    owned.response("owned");
+    await flush();
+    const answer = '{"PRIVATE-body":"秘密","overall_correctness":[true]}';
+    owned.data("owned", 'event: delta_encoding\ndata: "v1"\n\n' + rawFinal(answer) + done);
+    expect(observer.latestJsonCandidate()).toBe(enabled ? answer : undefined);
+    owned.session.emit("Network.loadingFinished", { requestId: "owned" });
+    await flush();
+    // A network-terminal event deletes the diagnostic capture, but not the selected private result.
+    expect(await observer.finishFinalJson()).toBe(enabled ? answer : undefined);
+    await observer.dispose();
+    expect(reports).toHaveLength(1);
+    expect(JSON.stringify(reports)).not.toContain("PRIVATE");
+    expect(JSON.stringify(reports)).not.toContain("秘密");
+    expect(JSON.stringify(reports)).not.toContain("overall_correctness");
+  }
+});
+
+test("finishFinalJson awaits buffered data before queued deltas, accepting aborted streams only with DONE", async () => {
+  for (const includeDone of [false, true]) {
+    const reports: any[] = [];
+    const buffered = Promise.withResolvers<{ bufferedData: string }>();
+    const owned = rawSession(buffered.promise);
+    const observer = new ChatGptStreamDiagnostics(value => reports.push(value), { collectFinalJson: true });
+    await observer.attach(owned.page);
+    observer.begin();
+    owned.request("owned");
+    owned.response("owned");
+    const answer = '{"overall_correctness":true}';
+    const initial = frame({ message: {
+      id: "synthetic", author: { role: "assistant" }, channel: "final", status: "in_progress", end_turn: false,
+      content: { content_type: "text", parts: ['{"overall_'] },
+    } });
+    owned.data("owned", frame({ p: "/message/content/parts/0", o: "append", v: 'correctness":true}' })
+      + frame({ p: "", o: "patch", v: [
+        { p: "/message/status", o: "replace", v: "finished_successfully" },
+        { p: "/message/end_turn", o: "replace", v: true },
+      ] }) + (includeDone ? done : ""));
+    owned.session.emit("Network.loadingFailed", { requestId: "owned", canceled: true, errorText: "net::ERR_ABORTED" });
+    const finishing = observer.finishFinalJson();
+    buffered.resolve({ bufferedData: Buffer.from(initial).toString("base64") });
+    expect(await finishing).toBe(includeDone ? answer : undefined);
+    await flush();
+    expect(reports[0]).toMatchObject({ terminal: "aborted", doneMarker: includeDone });
+    await observer.dispose();
+  }
+});
+
+test("begin resets candidates and old submissions cannot overwrite the current final", async () => {
+  const owned = rawSession();
+  const reports: any[] = [];
+  const observer = new ChatGptStreamDiagnostics(value => reports.push(value), { collectFinalJson: true });
+  await observer.attach(owned.page);
