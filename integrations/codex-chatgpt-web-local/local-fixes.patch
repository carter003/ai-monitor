+test("begin and page rebind invalidate pending and completed readbacks", async () => {
+  const f = fixture();
+  let resolveBody!: (body: Buffer) => void;
+  f.page.emit("response", { ...f.response(), body: () => new Promise<Buffer>(resolve => { resolveBody = resolve; }) });
+  f.observer.begin();
+  resolveBody(Buffer.from(JSON.stringify(readback())));
+  await Promise.resolve();
+  expect(await f.read()).toBeUndefined();
+  f.page.emit("response", f.response());
+  expect(await f.read()).toBe(text);
+  const next = fixture();
+  f.observer.attach(next.page as never);
